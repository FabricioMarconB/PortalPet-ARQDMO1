<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.TutorHomeActivity">

    <TextView
        android:id="@+id/tvTituloTutor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/titulo_tutor_home"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtituloTutor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/subtitulo_tutor_home"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloTutor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ListView
        android:id="@+id/listViewPets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:listSelector="@android:color/holo_green_light"
        app:layout_constraintTop_toBottomOf="@id/tvSubtituloTutor"
        app:layout_constraintBottom_toTopOf="@id/btnNovoPet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnNovoPet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_novo_pet"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnSobreClinica"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnMinhasConsultas" />

    <Button
        android:id="@+id/btnMinhasConsultas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_minhas_consultas"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btnSairTutor"
        app:layout_constraintStart_toEndOf="@id/btnNovoPet"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSobreClinica"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_sobre_clinica"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnSairTutor" />

    <Button
        android:id="@+id/btnSairTutor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_sair"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnSobreClinica"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>